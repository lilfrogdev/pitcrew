{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@pitcrew/protocol": ["./packages/protocol/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/worker/src/**/*.ts",
    "apps/worker/test/**/*.ts",
    "packages/protocol/src/**/*.ts"
  ]
}
