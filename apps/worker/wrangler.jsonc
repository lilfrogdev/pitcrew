{
  "name": "pitcrew-private-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORY",
        "class_name": "RepositoryAgent",
      },
      {
        "name": "CHANGE",
        "class_name": "ChangeAgent",
      },
      {
        "name": "REVIEW",
        "class_name": "ReviewAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepositoryAgent"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChangeAgent", "ReviewAgent"],
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "EXECUTION_MODE": "disabled",
  },
  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "FIXTURE_IDENTITY": "lilfrogdev",
        "EXECUTION_MODE": "fake",
        "LANDING_MODE": "fixture",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "REPOSITORY",
            "class_name": "RepositoryAgent",
          },
          {
            "name": "CHANGE",
            "class_name": "ChangeAgent",
          },
          {
            "name": "REVIEW",
            "class_name": "ReviewAgent",
          },
        ],
      },
    },
  },
  "containers": [
    {
      "class_name": "ChangeAgent",
      "scheduling_policy": "durable_object",
    },
  ],
}
