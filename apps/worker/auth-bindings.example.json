{
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "pitcrew-auth",
      "database_id": "APPROVED_D1_ID_REQUIRED",
      "migrations_dir": "migrations/auth"
    }
  ],
  "vars": {
    "AUTH_MODE": "password-only",
    "BETTER_AUTH_URL": "https://pitcrew-backend.pitcrew-004.workers.dev",
    "TRUSTED_PUBLISHER_ENABLED": "false",
    "ADOPT_ACCOUNT_ACTOR": "APPROVED_ACCOUNT_ACTOR_REQUIRED",
    "ADOPT_REPOSITORY_NAME": "APPROVED_EXISTING_REPOSITORY_NAME_REQUIRED",
    "ADOPT_REPOSITORY_ID": "APPROVED_IMMUTABLE_REPOSITORY_ID_REQUIRED"
  }
}
